{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "helios",
  "version": "0.1.0",
  "identifier": "app.helios.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Helios",
        "width": 1100,
        "height": 680,
        "minWidth": 380,
        "minHeight": 420,
        "decorations": false,
        "backgroundColor": "#0b0b0d",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--expose-gc --mse-video-buffer-size-limit-mb=16 --mse-audio-buffer-size-limit-mb=4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
